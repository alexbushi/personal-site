# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real secrets.
#
# NOTION_TOKEN
#   Create an internal integration at https://www.notion.com/my-integrations
#   and copy its secret. Then open the Articles database in Notion and connect
#   the integration to it via ··· → Connections. The token alone grants no
#   access; skipping the connection step is why the API returns 404 or [].
#
# NOTION_DATA_SOURCE_ID
#   Not the database ID. Since Notion API version 2025-09-03 a database can
#   hold several data sources, and queries address the data source. Get it by
#   calling notion.databases.retrieve({ database_id }) once and reading
#   data_sources[0].id.

NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
